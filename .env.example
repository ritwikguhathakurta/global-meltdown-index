# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free instant-signup key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Random string; set the same value in Vercel env vars. Protects /api/cron/pipeline
# from being triggered by anyone who isn't Vercel's own cron dispatcher.
CRON_SECRET=
