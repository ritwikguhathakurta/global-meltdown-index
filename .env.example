# ── Core (required to run the app and the daily pipeline) ──────────────────
# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Free instant-signup key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Random string; set the same value in Vercel env vars. Protects /api/cron/pipeline
# (and the other /api/cron/* routes below) from being triggered by anyone who
# isn't Vercel's own cron dispatcher / this repo's GitHub Actions workflows.
CRON_SECRET=

# ── Optional: specific engines/connectors degrade to UNAVAILABLE without these ──
# (the app and pipeline run fine with none of these set — you just won't see
# data from the feature each one unlocks)

# Ask Derivatives / Ask Geopolitics LLM panels + /dashboard/prediction analysis.
# Only one of GEMINI_API_KEY / OPENAI_API_KEY is required; Gemini is tried first.
GEMINI_API_KEY=
GEMINI_PREDICTION_MODEL=
OPENAI_API_KEY=
OPENAI_PREDICTION_MODEL=

# US EIA energy data (EIA Grid Monitor, world energy balances) — free key:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# ENTSO-E European power-grid day-ahead prices/load/generation — free key:
# https://transparency.entsoe.eu (Account Settings -> Web API Security Token)
ENTSOE_API_KEY=

# UN Comtrade bulk trade-flow data (energy/oleochemical/critical-minerals trade) —
# free tier key: https://comtradedeveloper.un.org
UN_COMTRADE_SUBSCRIPTION_KEY=

# Massive.com futures data (some soft-commodity/grain daily futures prices) —
# paid API, optional; the affected cells show N/A without it.
MASSIVE_API_KEY=

# Indonesia BPS (Badan Pusat Statistik) — palm oil / oilseeds country data.
BPS_API_KEY=

# UCDP (Uppsala Conflict Data Program) Georeferenced Event Dataset — free
# self-service token, powers the Geopolitical page's Conflict tab:
# https://ucdp.uu.se/apidocs
UCDP_ACCESS_TOKEN=

# Dhan broker relay for real-time MCX (India commodity futures) quotes — only
# relevant if you have a Dhan trading account; https://dhanhq.co
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ISO New England grid data (/dashboard/energy's US grid panel).
ISO_NE_USERNAME=
ISO_NE_PASSWORD=

# Binance API credentials for the Terminal page's optional broker connection
# (account/order status) — the Terminal page works without this.
BINANCE_API_KEY=
BINANCE_API_SECRET=
